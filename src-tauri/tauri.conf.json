{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS View",
  "version": "0.1.0",
  "identifier": "io.github.shavindra.dsview",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DS View",
        "width": 1240,
        "height": 800,
        "minWidth": 740,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data: https: http:; font-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "externalBin": [
      "binaries/ds-reader"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "licenses/DS-View.txt",
      "../node_modules/@fontsource/ibm-plex-mono/LICENSE": "licenses/ibm-plex-mono.txt",
      "../node_modules/@fontsource/ibm-plex-sans/LICENSE": "licenses/ibm-plex-sans.txt",
      "../node_modules/@fontsource/source-serif-4/LICENSE": "licenses/source-serif-4.txt"
    }
  }
}
